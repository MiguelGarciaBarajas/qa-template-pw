# =============================================================================
# QA Brain template — environment variables.  Copy to .env and fill in.
# NEVER commit .env. Retrieve secrets from your approved secret manager.
# Every connection is documented in CONNECTIONS.md.
# =============================================================================

# --- Jira Data Center (REST v2: ${JIRA_BASE_URL}/jira/rest/api/2) ---
JIRA_BASE_URL=https://jira.example.com
JIRA_USER=
# Personal Access Token (sent as Bearer)
JIRA_TOKEN=
JIRA_PROJECT=PROJ
# Fix Version applied to newly filed bugs / release tooling
JIRA_FIX_VERSION=
# Optional: epic key used by the RFT dashboard / daily status report
JIRA_EPIC=
# Some workflows require a "Designated Tester" on transitions/bug creation.
# JIRA_CF_DESIGNATED_TESTER = custom field id (e.g. customfield_12345); leave empty if unused.
JIRA_DESIGNATED_TESTER=
JIRA_CF_DESIGNATED_TESTER=
# Optional bug-creation defaults (priority id, extra fields as JSON)
JIRA_BUG_PRIORITY_ID=
JIRA_BUG_DEFAULTS_JSON=

# --- App under test / environments ---
APP_ENV=QA
APP_URL_QA=https://your-app-qa.example.com
# Optional: DEV URL for discovery-first runs (DEV_FIRST_DISCOVERY=true)
APP_URL_DEV=
# Optional: legacy app URL for parity / legacy-oracle mode
APP_URL_LEGACY=
APP_URL_PROD=

# --- Reviewer name shown in the AI-attribution footer of Jira comments/bugs ---
QA_OWNER_NAME=

# --- Jenkins (optional: automation job / report review) ---
JENKINS_BASE_URL=https://jenkins.example.com
JENKINS_USER=
JENKINS_TOKEN=

# --- Shared Edge CDP (never launch/close the browser from scripts) ---
CDP_ENDPOINT=http://localhost:9222
# Optional override for dedicated CDP profile path
# CDP_USER_DATA_DIR=C:\Users\<you>\AppData\Local\Microsoft\Edge\User Data QA-Brain-CDP
# Manual login mode (opens app and waits for you to sign in in the shared Edge tab)
MANUAL_LOGIN=false
MANUAL_LOGIN_TIMEOUT_SEC=240

# --- Run account resolution (retrieve values from the approved secret manager) ---
QA_USER_EMAIL=
# Optional fallback login alias
AUTO_USER=
# Dealer/customer-style (non-corporate) credentials; corporate SSO normally leaves these empty
QA_USER_PASS=
QA_USER_TOTP=
AUTO_PASS=
AUTO_TOTP=

# --- GitHub Models (autonomous agent: scripts/agent-validate.ts) ---
# PAT with models:read
GITHUB_TOKEN=
GITHUB_MODELS_CANDIDATES=openai/gpt-4.1-mini,openai/gpt-4.1,gpt-4o-mini,gpt-4o
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_FALLBACK_MODEL=openai/gpt-4.1
AGENT_MAX_STEPS=45

# --- Routing policy ---
MCP_FIRST=true
DEV_FIRST_DISCOVERY=false
LEGACY_ORACLE=false

# --- TestRail (scripts/testrail/*, scripts/import-testrail-cases.ts) ---
# No trailing slash (a trailing slash produces //api and a 404)
TESTRAIL_BASE_URL=https://your-company.testrail.com
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=0
TESTRAIL_SUITE_ID=0
# Optional: products config path (default scripts/testrail/products.config.json) and run-name prefix
# TESTRAIL_PRODUCTS_CONFIG=scripts/testrail/products.config.json
# TESTRAIL_RUN_NAME_PREFIX=
TESTRAIL_SUPPLEMENTAL_WHEN_MAPPED=false
# Optional: legacy TestRail case corpus for auto-match
# TESTRAIL_CASES_FILE=wiki\docs\testrail-legacy-cases.json
# TESTRAIL_MATCH_MIN_SCORE=3

# --- Grounded oracle docs (optional) ---
# ORACLE_DOCS_DIR=C:\path\to\wiki\docs
# RESEARCH_WIKI_DOCS_DIR=C:\path\to\research\wiki\docs
# Legacy flow -> new-app workflow map (optional)
# LEGACY_FLOW_MAP_FILE=wiki\docs\legacy-flow-map.json
# Section-aware flow guide map (optional)
# SECTION_FLOW_MAP_FILE=wiki\docs\section-flow-map.json

# --- Teams delivery for the daily status report (scripts/send-teams-report.mjs) ---
# Create each URL in Teams: Apps > Workflows > "When a Teams webhook request is
# received" -> action "Post message in a chat or channel" (Message =
# triggerBody()?['text']). The report is sent as a plain text message.
# Empty = that target is skipped.
TEAMS_WEBHOOK_PRIMARY=
TEAMS_WEBHOOK_SECONDARY=

# --- SmartLearn TOTP auto-login (scripts/smartlearn-auth.ts) ---
# MUST be a dedicated QA/service account, never a personal corporate employee account.
# SMARTLEARN_TOTP is the Base32 secret shown once when enrolling MFA ("Can't scan the
# QR code?" link), NOT a rotating 6-digit code.
SMARTLEARN_URL=https://smartlearn.example.com
SMARTLEARN_USER=
SMARTLEARN_PASS=
SMARTLEARN_TOTP=

# --- Daily Tempo autofill (scripts/tempo/run-daily-tempo.mjs) ---
# Tempo token (Jira Bearer is also used for the tempo-timesheets endpoints)
TEMPO_TOKEN=
# Tempo worker key for the current user (retrieve from Jira/Tempo profile)
TEMPO_WORKER=
# Optional: pin the weekly morning admin ticket. Empty = auto-detect the newest
# matching admin issue assigned to you (rotates weekly).
TEMPO_MORNING_TICKET=
# Summary fragment used to auto-detect the weekly admin ticket when TEMPO_MORNING_TICKET is empty
TEMPO_MORNING_SUMMARY=
# Set to 1 to allow worklog writes without the --write flag. A scheduled task that
# passes --write explicitly can leave this empty.
TEMPO_AUTOWRITE=
